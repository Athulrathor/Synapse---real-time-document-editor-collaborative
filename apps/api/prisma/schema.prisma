generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  LOCKED
  DELETED
}

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum NotificationResourceType {
  DOCUMENT
  WORKSPACE
  COMMENT
}

enum NotificationType {
  DOCUMENT_CREATED
  DOCUMENT_SHARED
  DOCUMENT_MENTION
  COMMENT_ADDED
  COMMENT_REPLY
  WORKSPACE_INVITATION
  WORKSPACE_ROLE_CHANGED
}

enum WorkspaceInvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  REVOKED
  EXPIRED
}

enum ActivityType {
  DOCUMENT_CREATED
  DOCUMENT_UPDATED
  VERSION_RESTORED
  DOCUMENT_ARCHIVED
  DOCUMENT_RESTORED
  DOCUMENT_DELETED
  DOCUMENT_PERMANENTLY_DELETED
  DOCUMENT_SHARED
  COMMENT_ADDED
  COMMENT_UPDATED
  COMMENT_DELETED
}

model User {
  id    String @id @default(uuid())
  email String @unique
  name  String

  status UserStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auth                         UserAuth?
  avatar                       Avatar?
  googleAccount                GoogleAccount?
  workspaceMembers             WorkspaceMember[]
  documents                    Document[]            @relation("DocumentCreator")
  createdVersions              Version[]
  notificationsReceived        Notification[]        @relation("NotificationRecipient")
  notificationsActed           Notification[]        @relation("NotificationActor")
  documentViews                DocumentView[]
  starredDocuments             StarredDocument[]
  workspaceInvitationsSent     WorkspaceInvitation[] @relation("WorkspaceInvitationSender")
  workspaceInvitationsReceived WorkspaceInvitation[] @relation("WorkspaceInvitationRecipient")
  activities                   Activity[]
  yjsDocumentUpdates           YjsDocumentUpdate[]
}

model Avatar {
  id        String   @id @default(uuid())
  name      String
  fileId    String   @unique
  path      String
  createdAt DateTime @default(now())

  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GoogleAccount {
  id            String   @id @default(uuid())
  userId        String   @unique
  googleId      String   @unique
  email         String
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
}

model UserAuth {
  id     String @id @default(uuid())
  userId String @unique

  passwordHash String?

  emailVerified    Boolean @default(false)
  twoFactorEnabled Boolean @default(false)

  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  tokenVersion Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OutboxEvent {
  id          String            @id @default(uuid())
  eventType   String
  aggregateId String
  payload     Json
  status      OutboxEventStatus @default(PENDING)
  attempts    Int               @default(0)
  availableAt DateTime          @default(now())
  processedAt DateTime?
  lastError   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status, availableAt])
  @@index([aggregateId])
  @@index([eventType, createdAt])
}

model Workspace {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     WorkspaceMember[]
  documents   Document[]
  invitations WorkspaceInvitation[]
  activities  Activity[]

  @@index([createdAt])
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(VIEWER)
  joinedAt    DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId, workspaceId])
}

model Document {
  id          String         @id @default(uuid())
  workspaceId String
  title       String         @default("Untitled document")
  content     Json?
  status      DocumentStatus @default(ACTIVE)
  createdById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdBy User              @relation("DocumentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  versions  Version[]
  yjsState  YjsDocumentState?
  views     DocumentView[]
  starredBy StarredDocument[]

  @@index([workspaceId, status, updatedAt])
  @@index([createdById])
}

model Version {
  id            String   @id @default(uuid())
  documentId    String
  versionNumber Int
  snapshot      Bytes
  createdById   String
  message       String?
  createdAt     DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  creator  User     @relation(fields: [createdById], references: [id])

  @@unique([documentId, versionNumber])
  @@index([documentId, createdAt])
}

model Notification {
  id           String                    @id @default(uuid())
  recipientId  String
  actorId      String?
  type         NotificationType
  title        String
  message      String
  resourceType NotificationResourceType?
  resourceId   String?
  dedupeKey    String?                   @unique
  resolvedAt   DateTime?
  isRead       Boolean                   @default(false)
  readAt       DateTime?
  createdAt    DateTime                  @default(now())

  recipient User  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([recipientId, isRead, createdAt])
  @@index([recipientId, createdAt])
  @@index([resourceType, resourceId])
}

model YjsDocumentState {
  documentId      String    @id
  snapshot        Bytes?
  snapshotVersion Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastEditedAt    DateTime?
  pendingActorIds String[]  @default([])
  lastCheckpointAt DateTime?

  document Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  updates  YjsDocumentUpdate[]

  @@map("yjs_document_states")
}

model YjsDocumentUpdate {
  id         String   @id @default(uuid())
  documentId String
  actorId    String?
  update     Bytes
  sequence   BigInt   @default(autoincrement())
  createdAt  DateTime @default(now())

  yjsDocument YjsDocumentState @relation(fields: [documentId], references: [documentId], onDelete: Cascade)
  actor       User?            @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([documentId, sequence])
  @@index([actorId])
  @@map("yjs_document_updates")
}

model DocumentView {
  id           String   @id @default(uuid())
  userId       String
  documentId   String
  lastViewedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([userId, documentId])
  @@index([userId, lastViewedAt])
  @@index([documentId])
}

model StarredDocument {
  id         String   @id @default(uuid())
  userId     String
  documentId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([userId, documentId])
  @@index([userId, createdAt])
  @@index([documentId])
}

model WorkspaceInvitation {
  id            String                    @id @default(uuid())
  workspaceId   String
  email         String
  invitedById   String
  invitedUserId String?
  role          WorkspaceRole             @default(VIEWER)
  status        WorkspaceInvitationStatus @default(PENDING)
  tokenHash     String                    @unique
  expiresAt     DateTime
  acceptedAt    DateTime?
  rejectedAt    DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  invitedBy User @relation("WorkspaceInvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)

  invitedUser User? @relation("WorkspaceInvitationRecipient", fields: [invitedUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([email, status])
  @@index([invitedUserId, status])
  @@index([expiresAt, status])
}

model Activity {
  id   String       @id @default(uuid())
  type ActivityType

  actorId     String
  workspaceId String
  documentId  String?
  versionId   String?

  metadata  Json?
  createdAt DateTime @default(now())

  actor     User      @relation(fields: [actorId], references: [id], onDelete: Restrict)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
  @@index([actorId, createdAt])
  @@index([documentId, createdAt])
  @@index([versionId])
}
